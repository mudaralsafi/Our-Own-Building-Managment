# For an external hosting service, configure these in its private settings.
# This file is documentation; npm start does not automatically load .env.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
PUBLIC_URL=https://your-building.example.com
DATA_PATH=/var/data/building.sqlite
# Set a random value of at least 32 characters before the first hosted launch.
# Render's blueprint generates it securely; do not commit the generated value.
SETUP_TOKEN=
